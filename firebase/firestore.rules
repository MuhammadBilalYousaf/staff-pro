rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return userDoc().role;
    }

    function isSuperAdmin() {
      return signedIn() && userExists() && role() == 'superAdmin';
    }

    function isBusinessAdmin(bizId) {
      return signedIn()
        && userExists()
        && role() == 'businessAdmin'
        && userDoc().businessId == bizId;
    }

    function isManager(bizId, branchId) {
      return signedIn()
        && userExists()
        && role() == 'manager'
        && userDoc().businessId == bizId
        && userDoc().branchId == branchId;
    }

    function isEmployee(bizId, branchId) {
      return signedIn()
        && userExists()
        && role() == 'employee'
        && userDoc().businessId == bizId
        && userDoc().branchId == branchId;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function sameBusiness(bizId) {
      return signedIn() && userExists() && userDoc().businessId == bizId;
    }

    function bootstrapOpen() {
      return !exists(/databases/$(database)/documents/platform/bootstrap)
        || get(/databases/$(database)/documents/platform/bootstrap).data.superAdminCreated != true;
    }

    function validRole(r) {
      return r in ['superAdmin', 'businessAdmin', 'manager', 'employee'];
    }

    match /platform/public {
      allow read: if true;
      allow create: if bootstrapOpen();
      allow update: if isSuperAdmin() || bootstrapOpen();
    }

    match /platform/settings {
      // Signed-in roles need geofence defaults; secret is also on platform/public.
      allow read: if signedIn() || bootstrapOpen();
      allow create: if bootstrapOpen();
      allow update: if isSuperAdmin() || (bootstrapOpen() && signedIn());
    }

    match /platform/bootstrap {
      allow read: if true;
      allow create: if bootstrapOpen();
      allow update: if signedIn() && (isSuperAdmin() || bootstrapOpen());
    }

    match /users/{userId} {
      allow read: if isSuperAdmin()
        || isOwner(userId)
        || (signedIn() && userExists() && role() == 'businessAdmin'
            && resource.data.businessId == userDoc().businessId)
        || (signedIn() && userExists() && role() == 'manager'
            && resource.data.branchId == userDoc().branchId);

      allow create: if signedIn() && validRole(request.resource.data.role) && (
        (isOwner(userId)
          && request.resource.data.role == 'superAdmin'
          && bootstrapOpen())
        || (isOwner(userId) && request.resource.data.role != 'superAdmin')
        || isSuperAdmin()
        || (isBusinessAdmin(request.resource.data.businessId)
            && request.resource.data.role in ['businessAdmin', 'manager', 'employee'])
        || (role() == 'manager'
            && request.resource.data.role == 'employee'
            && request.resource.data.branchId == userDoc().branchId
            && request.resource.data.businessId == userDoc().businessId)
      );

      allow update: if isSuperAdmin()
        || isOwner(userId)
        || (isBusinessAdmin(resource.data.businessId)
            && request.resource.data.businessId == resource.data.businessId)
        || (role() == 'manager'
            && resource.data.role == 'employee'
            && resource.data.branchId == userDoc().branchId
            && request.resource.data.branchId == userDoc().branchId);

      allow delete: if false;
    }

    match /businesses/{bizId} {
      allow read: if isSuperAdmin()
        || isBusinessAdmin(bizId)
        || (signedIn() && userExists() && userDoc().businessId == bizId);
      allow create: if isSuperAdmin();
      // Business admins may update their own business profile (not create new ones).
      allow update: if isSuperAdmin() || isBusinessAdmin(bizId);
      allow delete: if false;
    }

    match /branches/{id} {
      allow read: if isSuperAdmin()
        || (signedIn() && userExists() && (
          isBusinessAdmin(resource.data.businessId)
          || userDoc().branchId == id
          || sameBusiness(resource.data.businessId)
        ));
      allow create, update: if isSuperAdmin()
        || isBusinessAdmin(request.resource.data.businessId);
      allow delete: if false;
    }

    match /shifts/{id} {
      allow read: if isSuperAdmin() || sameBusiness(resource.data.businessId);
      allow create, update: if isSuperAdmin()
        || isBusinessAdmin(request.resource.data.businessId);
      allow delete: if false;
    }

    match /expenseCategories/{id} {
      allow read: if isSuperAdmin() || sameBusiness(resource.data.businessId);
      allow create, update: if isSuperAdmin()
        || isBusinessAdmin(request.resource.data.businessId)
        || (role() == 'manager'
            && request.resource.data.businessId == userDoc().businessId
            && get(/databases/$(database)/documents/platform/settings).data.allowManagerCategories == true);
      allow delete: if false;
    }

    match /sales/{id} {
      allow read: if isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || isManager(resource.data.businessId, resource.data.branchId)
        || isOwner(resource.data.userId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (isBusinessAdmin(request.resource.data.businessId)
            || isManager(request.resource.data.businessId, request.resource.data.branchId)
            || isEmployee(request.resource.data.businessId, request.resource.data.branchId));
      allow update: if isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || isOwner(resource.data.userId);
      allow delete: if false;
    }

    match /expenses/{id} {
      allow read: if isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || isManager(resource.data.businessId, resource.data.branchId)
        || isOwner(resource.data.userId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && (isBusinessAdmin(request.resource.data.businessId)
            || isManager(request.resource.data.businessId, request.resource.data.branchId)
            || isEmployee(request.resource.data.businessId, request.resource.data.branchId));
      allow update: if isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || isOwner(resource.data.userId);
      allow delete: if false;
    }

    match /attendance/{id} {
      allow read: if isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || isManager(resource.data.businessId, resource.data.branchId)
        || isOwner(resource.data.userId);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId)
        || isBusinessAdmin(resource.data.businessId)
        || isSuperAdmin();
      allow delete: if false;
    }

    match /notifications/{id} {
      allow read, update: if isOwner(resource.data.recipientUserId) || isSuperAdmin();
      allow create: if signedIn();
      allow delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if isSuperAdmin()
        || (signedIn() && userExists() && role() == 'businessAdmin'
            && resource.data.businessId == userDoc().businessId);
      // Updates allowed so clients can merge-persist historical log rows.
      allow create, update: if signedIn();
      allow delete: if false;
    }

    match /assignments/{id} {
      allow read: if isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || isOwner(resource.data.userId)
        || (role() == 'manager'
            && resource.data.businessId == userDoc().businessId
            && (resource.data.toBranchId == userDoc().branchId
                || resource.data.fromBranchId == userDoc().branchId));
      allow create, update: if isSuperAdmin()
        || isBusinessAdmin(request.resource.data.businessId);
      allow delete: if false;
    }

    match /passwordRequests/{id} {
      allow read: if isSuperAdmin()
        || isOwner(resource.data.userId)
        || isBusinessAdmin(resource.data.businessId)
        || (role() == 'manager' && resource.data.branchId == userDoc().branchId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || (role() == 'manager' && resource.data.branchId == userDoc().branchId)
        || isOwner(resource.data.userId);
      allow delete: if false;
    }

    match /publicBusinesses/{slug} {
      allow read: if resource.data.status == 'active'
        || isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || sameBusiness(resource.data.businessId);
      allow create: if (isSuperAdmin() || isBusinessAdmin(request.resource.data.businessId))
        && request.resource.data.slug == slug
        && request.resource.data.businessId is string
        && request.resource.data.status == 'active';
      allow update: if (isSuperAdmin() || isBusinessAdmin(resource.data.businessId))
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.slug == slug
        && request.resource.data.status in ['active', 'inactive'];
      allow delete: if false;
    }

    function staffForOrder() {
      return isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || (signedIn() && userExists()
            && role() in ['manager', 'employee']
            && userDoc().businessId == resource.data.businessId);
    }

    match /customers/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.guest is bool
        && request.resource.data.name is string
        && request.resource.data.phone is string;
      allow delete: if false;
    }

    match /customerOrders/{orderId} {
      allow read: if signedIn() && resource.data.customerUid == request.auth.uid;
      allow read: if staffForOrder();
      allow list: if isSuperAdmin()
        || (signedIn() && userExists() && role() in ['businessAdmin', 'manager', 'employee']
            && resource.data.businessId == userDoc().businessId)
        || (signedIn() && resource.data.customerUid == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.businessId is string
        && request.resource.data.customerName is string
        && request.resource.data.phone is string
        && request.resource.data.orderType in ['dineIn', 'takeaway']
        && request.resource.data.paymentMethod == 'manual'
        && request.resource.data.paymentReference is string
        && request.resource.data.paymentReference.size() > 2
        && request.resource.data.paymentReference.size() < 80
        && request.resource.data.paymentStatus == 'PENDING_PAYMENT_VERIFICATION'
        && request.resource.data.orderStatus == 'PENDING_PAYMENT_VERIFICATION'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 40
        && request.resource.data.subtotal is number
        && request.resource.data.pointsRedeemed is number
        && request.resource.data.pointsRedeemed >= 0
        && request.resource.data.loyaltyDiscount == request.resource.data.pointsRedeemed
        && request.resource.data.loyaltyPointsEarned == 0
        && request.resource.data.total == request.resource.data.subtotal - request.resource.data.loyaltyDiscount
        && request.resource.data.total >= 0
        && (
          request.resource.data.pointsRedeemed == 0
          || (
            request.auth.token.firebase.sign_in_provider != 'anonymous'
            && exists(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.businessId + '_' + request.auth.uid)/transactions/$(orderId + '_REDEEM'))
            && get(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.businessId + '_' + request.auth.uid)/transactions/$(orderId + '_REDEEM')).data.points == -request.resource.data.pointsRedeemed
            && get(/databases/$(database)/documents/loyaltyAccounts/$(request.resource.data.businessId + '_' + request.auth.uid)).data.lastAppliedId == orderId + '_REDEEM'
          )
        );

      allow update: if staffForOrder()
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total
        && request.resource.data.subtotal == resource.data.subtotal
        && request.resource.data.paymentReference == resource.data.paymentReference
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && (
          !('pointsRedeemed' in resource.data)
          || request.resource.data.pointsRedeemed == resource.data.pointsRedeemed
        )
        && (
          !('loyaltyDiscount' in resource.data)
          || request.resource.data.loyaltyDiscount == resource.data.loyaltyDiscount
        )
        && (
          request.resource.data.get('loyaltyPointsEarned', 0) == resource.data.get('loyaltyPointsEarned', 0)
          || (request.resource.data.orderStatus == 'COMPLETED'
              && request.resource.data.loyaltyPointsEarned == math.floor(resource.data.total / 10))
        )
        && request.resource.data.paymentStatus in ['PENDING_PAYMENT_VERIFICATION', 'PAYMENT_VERIFIED', 'PAYMENT_REJECTED']
        && request.resource.data.orderStatus in ['PENDING_PAYMENT_VERIFICATION', 'PAYMENT_VERIFIED', 'ACCEPTED', 'PREPARING', 'READY', 'COMPLETED', 'PAYMENT_REJECTED', 'CANCELLED'];

      allow update: if signedIn()
        && resource.data.customerUid == request.auth.uid
        && resource.data.orderStatus == 'COMPLETED'
        && request.resource.data.orderStatus == resource.data.orderStatus
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.total == resource.data.total
        && request.resource.data.subtotal == resource.data.subtotal
        && request.resource.data.items == resource.data.items
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.paymentReference == resource.data.paymentReference
        && request.resource.data.loyaltyPointsEarned == math.floor(resource.data.total / 10);

      allow delete: if false;
    }

    function loyaltyStaff(businessId) {
      return isSuperAdmin() || isBusinessAdmin(businessId)
        || (signedIn() && userExists() && role() in ['manager', 'employee'] && userDoc().businessId == businessId);
    }

    function loyaltyTxnPath(businessId, customerId, txnId) {
      return /databases/$(database)/documents/loyaltyAccounts/$(businessId + '_' + customerId)/transactions/$(txnId);
    }

    match /loyaltyAccounts/{accountId} {
      allow get: if signedIn() && (
        accountId.matches('.*_' + request.auth.uid)
        || (resource != null && loyaltyStaff(resource.data.businessId))
      );
      allow list: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || loyaltyStaff(resource.data.businessId)
      );

      allow create: if signedIn()
        && accountId == request.resource.data.businessId + '_' + request.resource.data.customerId
        && (request.auth.uid == request.resource.data.customerId || loyaltyStaff(request.resource.data.businessId))
        && request.resource.data.pointsBalance is number
        && request.resource.data.pointsBalance >= 0
        && request.resource.data.lifetimePoints is number
        && request.resource.data.applied[request.resource.data.lastAppliedId] == true
        && exists(loyaltyTxnPath(request.resource.data.businessId, request.resource.data.customerId, request.resource.data.lastAppliedId))
        && request.resource.data.pointsBalance == (get(loyaltyTxnPath(request.resource.data.businessId, request.resource.data.customerId, request.resource.data.lastAppliedId)).data.points < 0 ? 0 : get(loyaltyTxnPath(request.resource.data.businessId, request.resource.data.customerId, request.resource.data.lastAppliedId)).data.points)
        && (
          get(loyaltyTxnPath(request.resource.data.businessId, request.resource.data.customerId, request.resource.data.lastAppliedId)).data.type == 'EARN'
            ? request.resource.data.lifetimePoints == request.resource.data.pointsBalance
            : request.resource.data.lifetimePoints == 0
        );

      allow update: if signedIn()
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.lastAppliedId != resource.data.get('lastAppliedId', '')
        && (
          !('applied' in resource.data)
          || !(request.resource.data.lastAppliedId in resource.data.applied)
        )
        && request.resource.data.applied[request.resource.data.lastAppliedId] == true
        && (request.auth.uid == resource.data.customerId || loyaltyStaff(resource.data.businessId))
        && exists(loyaltyTxnPath(resource.data.businessId, resource.data.customerId, request.resource.data.lastAppliedId))
        && request.resource.data.pointsBalance == (resource.data.pointsBalance + get(loyaltyTxnPath(resource.data.businessId, resource.data.customerId, request.resource.data.lastAppliedId)).data.points < 0 ? 0 : resource.data.pointsBalance + get(loyaltyTxnPath(resource.data.businessId, resource.data.customerId, request.resource.data.lastAppliedId)).data.points)
        && (
          get(loyaltyTxnPath(resource.data.businessId, resource.data.customerId, request.resource.data.lastAppliedId)).data.type == 'EARN'
            ? request.resource.data.lifetimePoints == resource.data.lifetimePoints + get(loyaltyTxnPath(resource.data.businessId, resource.data.customerId, request.resource.data.lastAppliedId)).data.points
            : request.resource.data.lifetimePoints == resource.data.get('lifetimePoints', 0)
        );

      allow delete: if false;

      match /transactions/{txnId} {
        allow get: if signedIn() && (
          accountId.matches('.*_' + request.auth.uid)
          || (resource != null && loyaltyStaff(resource.data.businessId))
        );
        allow list: if signedIn() && (
          resource.data.customerId == request.auth.uid
          || isSuperAdmin()
          || (userExists()
              && role() in ['businessAdmin', 'manager', 'employee']
              && resource.data.businessId == userDoc().businessId)
        );

        allow create: if signedIn()
          && request.resource.data.customerId is string
          && request.resource.data.businessId is string
          && request.resource.data.orderId is string
          && request.resource.data.points is number
          && request.resource.data.type in ['EARN', 'REDEEM', 'REVERSAL', 'ADJUSTMENT']
          && accountId == request.resource.data.businessId + '_' + request.resource.data.customerId
          && (request.auth.uid == request.resource.data.customerId || loyaltyStaff(request.resource.data.businessId))
          && (
            request.resource.data.type == 'EARN'
              && txnId == request.resource.data.orderId + '_EARN'
              && get(/databases/$(database)/documents/customerOrders/$(request.resource.data.orderId)).data.orderStatus == 'COMPLETED'
              && (
                !('customerKind' in get(/databases/$(database)/documents/customerOrders/$(request.resource.data.orderId)).data)
                || get(/databases/$(database)/documents/customerOrders/$(request.resource.data.orderId)).data.customerKind != 'guest'
              )
              && get(/databases/$(database)/documents/customerOrders/$(request.resource.data.orderId)).data.customerUid == request.resource.data.customerId
              && request.resource.data.points == math.floor(get(/databases/$(database)/documents/customerOrders/$(request.resource.data.orderId)).data.total / 10)
              && request.resource.data.points > 0
            || request.resource.data.type == 'REDEEM'
              && txnId == request.resource.data.orderId + '_REDEEM'
              && request.auth.uid == request.resource.data.customerId
              && request.auth.token.firebase.sign_in_provider != 'anonymous'
              && request.resource.data.points < 0
            || request.resource.data.type == 'REVERSAL'
              && (
                txnId == request.resource.data.orderId + '_EARN_REVERSAL'
                  && get(/databases/$(database)/documents/customerOrders/$(request.resource.data.orderId)).data.orderStatus in ['CANCELLED', 'PAYMENT_REJECTED']
                  && exists(loyaltyTxnPath(request.resource.data.businessId, request.resource.data.customerId, request.resource.data.orderId + '_EARN'))
                  && request.resource.data.points == -get(loyaltyTxnPath(request.resource.data.businessId, request.resource.data.customerId, request.resource.data.orderId + '_EARN')).data.points
                || txnId == request.resource.data.orderId + '_REDEEM_REVERSAL'
                  && get(/databases/$(database)/documents/customerOrders/$(request.resource.data.orderId)).data.orderStatus in ['CANCELLED', 'PAYMENT_REJECTED']
                  && request.resource.data.points == get(/databases/$(database)/documents/customerOrders/$(request.resource.data.orderId)).data.pointsRedeemed
                  && request.resource.data.points > 0
              )
          );

        allow update, delete: if false;
      }
    }

    match /publicMenus/{businessId} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
        || (isBusinessAdmin(businessId)
            && request.resource.data.businessId == businessId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
